<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Amplify stores the Cognito session in the Keychain. Without an explicit access group, builds that
	     aren't signed with the team (e.g. simulator builds) have no application-identifier and every
	     Keychain call fails with errSecMissingEntitlement (-34018), which breaks sign-in. -->
	<!-- Shared container for the dashboard snapshot the home-screen widgets read. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.rookfitness.app</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.rookfitness.app</string>
	</array>
</dict>
</plist>
